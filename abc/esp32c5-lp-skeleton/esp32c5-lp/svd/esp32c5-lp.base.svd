        <register>
          <name>LPMEM_FORCE</name>
          <description>Configures the LP_MEM clk gate force parameter</description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>LPMEM_CLK_FORCE_ON</name>
              <description>Configures whether ot not force open the clock gate of LP MEM
0: Invalid. The clock gate controlled by hardware FSM
1: Force open clock gate of LP MEM</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LPPERI</name>
          <description>Configures the LP peri clk</description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <resetValue>0x20000000</resetValue>
          <fields>
            <field>
              <name>HUK_CLK_SEL</name>
              <description>Configures the source clk of HUK
0: 0: RC_FAST_CLK
1: XTAL_D2_CLK</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>LP_I2C_CLK_SEL</name>
              <description>Configures the source clk of LP I2C.
0: LP_FAST_CLK
1: XTAL_D2_CLK</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>LP_UART_CLK_SEL</name>
              <description>Configures the source clk of LP UART.
0: LP_FAST_CLK
1: XTAL_D2_CLK</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>XTAL32K</name>
          <description>Configures the XTAL32K parameter</description>
